---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';
const team = `${SITE.name} ${SITE.editorialTeam}`;
const schema = [{ '@type': 'AboutPage', name: `About ${SITE.name}`, url: `${SITE.url}/about/`, mainEntity: { '@id': `${SITE.url}/#org` } }];
---
<Base title={`About Us and Our Editorial Team | ${SITE.name}`} description={`Who writes ${SITE.name}, how every page is fact-checked against CDC, WHO and USPSTF guidance, and how we keep money out of medical decisions.`} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />
    <div class="layout-2" style="margin-top: 16px;">
      <article class="main">
        <header class="page-head">
          <h1>About {SITE.name}</h1>
          <p class="lede">We help people in the US understand STDs, choose the right test and know what to do next, without judgment or scare tactics.</p>
        </header>
        <div class="prose" style="margin-top: 28px;">
          <h2 id="why">Why this site exists</h2>
          <p>Most people search for STD information at an anxious moment: after a condom broke, after a partner called, or after noticing a symptom. They need a clear answer fast, and too often they find forums, outdated advice or pages built only to sell a kit.</p>
          <p>We write for that moment. Each page answers one question, puts the answer at the top and tells you when a home test is fine and when you need a clinician today.</p>

          <h2 id="team">The {SITE.editorialTeam}</h2>
          <p>Every article is researched, written, fact-checked and updated by the {team}. We publish as a team rather than under individual bylines, and the team is accountable for every page as a whole.</p>
          <p>We are health writers and editors, not your doctor. We do not diagnose, prescribe or give personal medical advice. That is why every page links to its sources and explains when to see a licensed clinician.</p>

          <h2 id="process">How every page is made</h2>
          <ol>
            <li><strong>One question per page.</strong> We map each topic to a single search question so pages don't repeat or contradict each other.</li>
            <li><strong>Primary sources first.</strong> We build each page from the CDC STI Treatment Guidelines, CDC fact sheets, USPSTF recommendations, WHO guidance, FDA device records and peer-reviewed studies.</li>
            <li><strong>Fact-check.</strong> A second pass checks every number, timing and treatment claim against the cited source. Anything that can't be traced to a source is removed.</li>
            <li><strong>Safety check.</strong> Pages about symptoms or exposure get a clear "when to get care now" box with 911 and PEP guidance.</li>
            <li><strong>Updates.</strong> We re-check pages when the CDC, USPSTF or FDA updates its guidance, and at least once a year. The date at the top of each page shows the last check.</li>
          </ol>
          <p>The full rules are in our <a href="/editorial-policy/">editorial policy</a>.</p>

          {SITE.advisors.length > 0 && (
            <>
              <h2 id="advisors">Outside medical advisors</h2>
              <p>These licensed clinicians advise the {SITE.editorialTeam}. We verify each license with the issuing state board before listing it.</p>
              <ul>
                {SITE.advisors.map((a) => <li><strong>{a.name}, {a.credentials}</strong>: {a.role}. License {a.license}, verified {a.verifiedOn}.</li>)}
              </ul>
            </>
          )}

          <h2 id="money">How we make money</h2>
          <p>Some links go to at-home test providers that pay us a commission when someone buys. That keeps the site free and ad-free. Commissions never decide what a page says, and pages that mention kits also show free and low-cost testing. Details: <a href="/how-we-make-money/">how we make money</a>.</p>

          <h2 id="privacy">Privacy by design</h2>
          <p>We don't run advertising trackers. Our symptom checker and window period calculator work entirely in your browser, so your answers never reach us. Read our <a href="/privacy/">privacy policy</a>.</p>

          <h2 id="contact">Contact us</h2>
          <p>Found an error, or have a question about a page? <a href="/contact/">Contact the {SITE.editorialTeam}</a>. We read every message and log every correction.</p>
        </div>
      </article>
      <aside class="side">
        <div class="panel">
          <span class="h">Our standards</span>
          <a href="/editorial-policy/">Editorial policy</a>
          <a href="/editorial-policy/#corrections">Corrections</a>
          <a href="/how-we-make-money/">How we make money</a>
          <a href="/medical-disclaimer/">Medical disclaimer</a>
        </div>
      </aside>
    </div>
  </div>
</Base>
