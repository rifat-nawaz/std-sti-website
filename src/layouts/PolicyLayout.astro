---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';
import { POLICY_NAV } from '../data/nav';
interface Props { title: string; seoTitle?: string; description: string; updated: string; summary?: string[] }
const { title, seoTitle, description, updated, summary = [] } = Astro.props;
const path = Astro.url.pathname;
const date = new Date(updated + 'T00:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const schema = [{ '@type': 'WebPage', name: title, url: new URL(path, SITE.url).toString(), dateModified: updated, publisher: { '@id': `${SITE.url}/#org` } }];
---
<Base title={`${seoTitle ?? title} | ${SITE.name}`} description={description} schema={schema}>
  <div class="wrap">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: title }]} />
    <div class="layout-2" style="margin-top: 16px;">
      <article class="main">
        <header class="page-head">
          <h1>{title}</h1>
          <p style="margin: 0; font-size: 14px; color: var(--muted);">Last updated <time datetime={updated}>{date}</time></p>
        </header>
        {summary.length > 0 && (
          <div class="answer">
            <span class="label">The short version</span>
            <ul style="margin: 10px 0 0; padding-left: 20px; line-height: 1.6; font-size: 17px;">{summary.map((s) => <li set:html={s} />)}</ul>
          </div>
        )}
        <div class="prose" style="margin-top: 28px;"><slot /></div>
      </article>
      <aside class="side">
        <nav class="side-block" aria-label="Policies">
          <span class="h">Policies</span>
          <div class="toc">{POLICY_NAV.map((p) => <a href={p.href} aria-current={p.href === path ? 'page' : undefined}>{p.label}</a>)}</div>
        </nav>
      </aside>
    </div>
  </div>
</Base>
