---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">Frequently asked questions</h2>
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p set:html={f.a} />
      </details>
    ))}
  </section>
)}
