---
import { editorialByline } from '../config/site';
import { formatDate, isoDate } from '../lib/paths';
interface Props { updated: Date }
const { updated } = Astro.props;
---
<div class="byline">
  <span class="by">By <a href="/editorial-team/">{editorialByline}</a></span>
  <span>Fact-checked against <a href="/editorial-policy/" class="plain">CDC, WHO and USPSTF guidance</a> · Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>
</div>
