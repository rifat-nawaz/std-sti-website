---
import Logo from './Logo.astro';
import { CONDITIONS } from '../data/conditions';
import { TESTING_MENU, GUIDES_MENU } from '../data/nav';
const core = CONDITIONS.filter((c) => c.group === 'core');
const more = CONDITIONS.filter((c) => c.group !== 'core');
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap header-row">
    <Logo />
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav class="nav" id="main-nav" aria-label="Main">
      <details class="dd">
        <summary>Conditions</summary>
        <div class="menu">
          {core.map((c) => <a href={`/${c.slug}/`}>{c.menuName}</a>)}
          <span class="menu-label">More and look-alikes</span>
          {more.map((c) => <a href={`/${c.slug}/`}>{c.menuName}</a>)}
          <a href="/conditions/"><strong>View all conditions</strong></a>
        </div>
      </details>
      <details class="dd">
        <summary>At-Home Testing</summary>
        <div class="menu">
          {TESTING_MENU.map((m) => <a href={m.href}>{m.label}{m.desc && <span class="menu-desc">{m.desc}</span>}</a>)}
        </div>
      </details>
      <details class="dd">
        <summary>Symptoms &amp; Guides</summary>
        <div class="menu">
          {GUIDES_MENU.map((m) => <a href={m.href}>{m.label}{m.desc && <span class="menu-desc">{m.desc}</span>}</a>)}
        </div>
      </details>
      <a href="/knowledge-care/">Knowledge Care</a>
      <a href="/about/">About &amp; Editorial</a>
    </nav>
    <a class="btn header-cta" href="/std-testing/best-at-home-std-tests/">Get tested</a>
  </div>
</header>
<script>
  // Phone: show or hide the whole menu with one button.
  const header = document.querySelector('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  toggle.addEventListener('click', () => {
    const open = header.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close' : 'Menu';
  });
  // Only one menu open at a time; close on outside click or Escape.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.dd'));
  menus.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) menus.forEach((o) => { if (o !== d) o.open = false; });
  }));
  // Desktop: open on hover. Touch and keyboard still open on tap or Enter.
  const canHover = window.matchMedia('(hover: hover) and (min-width: 1101px)');
  menus.forEach((d) => {
    let timer: number | undefined;
    d.addEventListener('mouseenter', () => { if (!canHover.matches) return; clearTimeout(timer); d.open = true; });
    d.addEventListener('mouseleave', () => { if (!canHover.matches) return; timer = window.setTimeout(() => (d.open = false), 160); });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('details.dd')) menus.forEach((d) => (d.open = false));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
</script>
