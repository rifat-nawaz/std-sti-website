---
// Compact guide directory on hub pages: one tile per topic; a tile opens to show its guides.
import { urlFor, type Article } from '../lib/paths';
interface Props { entries: Article[]; heading: string }
const { entries, heading } = Astro.props;
const groups = new Map<string, Article[]>();
for (const e of entries) {
  const g = groups.get(e.data.cluster) ?? [];
  g.push(e);
  groups.set(e.data.cluster, g);
}
---
{entries.length > 0 && (
  <section class="guides" aria-labelledby="all-h">
    <div class="guides-head">
      <h2 id="all-h">{heading}</h2>
      <span class="guides-count">{`${entries.length} guides · ${groups.size} topics`}</span>
    </div>
    <p class="guides-hint">Pick a topic to see its guides.</p>
    <div class="guides-grid">
      {[...groups].map(([cluster, list]) => (
        <details class="gtile">
          <summary>
            <span class="gname">{cluster}</span>
            <span class="gnum">{`${list.length} ${list.length === 1 ? 'guide' : 'guides'}`}</span>
            <span class="gchev" aria-hidden="true"></span>
          </summary>
          <ul>
            {list.map((e) => <li><a href={urlFor(e.id)}>{e.data.title}</a></li>)}
          </ul>
        </details>
      ))}
    </div>
  </section>
)}
