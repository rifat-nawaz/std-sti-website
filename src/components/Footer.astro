---
import { SITE } from '../config/site';
import { CONDITIONS } from '../data/conditions';
import { TESTING_MENU, FOOTER_POLICIES } from '../data/nav';
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div style="flex: 2 1 260px; display: flex; flex-direction: column; gap: 10px;">
      <span style="font-weight: 700; color: #fff; font-size: 18px;">{SITE.name}</span>
      <p style="margin: 0; font-size: 15px; line-height: 1.6;">{SITE.description}</p>
      <p style="margin: 0; font-size: 15px; line-height: 1.6;"><strong style="color:#fff">Emergency?</strong> Call 911. Crisis support: call or text 988.</p>
    </div>
    <nav aria-label="Conditions">
      <span class="h">Conditions</span>
      {CONDITIONS.filter((c) => c.group === 'core').map((c) => <a href={`/${c.slug}/`}>{c.menuName}</a>)}
      <a href="/conditions/">All conditions</a>
      <a href="/knowledge-care/">Knowledge Care</a>
    </nav>
    <nav aria-label="Testing">
      <span class="h">Testing</span>
      {TESTING_MENU.map((m) => <a href={m.href}>{m.label}</a>)}
      <a href="/guides/symptom-checker/">Symptom checker</a>
    </nav>
    <nav aria-label="Company and policies">
      <span class="h">About</span>
      {FOOTER_POLICIES.map((p) => <a href={p.href}>{p.label}</a>)}
    </nav>
  </div>
  <div class="wrap foot-legal">
    <p style="margin:0 0 8px;">{SITE.name} gives general health information. It is not medical advice, a diagnosis or a substitute for care from a licensed clinician. We may earn a commission when you buy through partner links; this never changes our medical information. <a href="/how-we-make-money/">How we make money</a>.</p>
    <p style="margin:0;">© {year} {SITE.company.legalName}. All rights reserved.</p>
  </div>
</footer>
