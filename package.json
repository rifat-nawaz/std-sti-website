{
  "name": "std-sti-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf .astro node_modules/.astro && astro build && node scripts/check-site.mjs",
    "preview": "astro preview",
    "check:content": "node scripts/check-site.mjs",
    "check:launch": "SITE_ENV=production astro build && node scripts/check-site.mjs --strict",
    "check:links": "node scripts/check-external-links.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/literata": "5.2.8",
    "@fontsource-variable/public-sans": "5.2.7",
    "astro": "6.4.8"
  },
  "engines": {
    "node": "22.x"
  }
}
